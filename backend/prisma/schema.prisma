generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  roleCode    String   @unique @map("role_code") @db.VarChar(20)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model Domain {
  id             Int                   @id @default(autoincrement())
  domainName     String                @unique @map("domain_name") @db.VarChar(100)
  domainCode     String                @unique @map("domain_code") @db.VarChar(50)
  description    String?
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  questionPapers QuestionPaperDomain[]
  students       Student[]
  playlists      Playlist[]

  @@map("domains")
}

model InternStatus {
  id          Int       @id @default(autoincrement())
  statusName  String    @unique @map("status_name") @db.VarChar(50)
  statusCode  String    @unique @map("status_code") @db.VarChar(20)
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  students    Student[]

  @@map("intern_status")
}

model User {
  id                    Int              @id @default(autoincrement())
  email                 String           @unique @db.VarChar(255)
  passwordHash          String?          @map("password_hash") @db.VarChar(255)
  fullName              String?          @map("full_name") @db.VarChar(255)
  roleId                Int              @map("role_id")
  isActive              Boolean          @default(true) @map("is_active")
  lastLoginAt           DateTime?        @map("last_login_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  createdBy             Int?             @map("created_by")
  activityLogs          ActivityLog[]
  fileUploads           FileUpload[]
  questionPapersCreated QuestionPaper[]  @relation("QuestionPaperCreator")
  questionPapersUpdated QuestionPaper[]  @relation("QuestionPaperUpdater")
  questionsCreated      Question[]       @relation("QuestionCreator")
  questionsUpdated      Question[]       @relation("QuestionUpdater")
  studentsCreated       Student[]        @relation("StudentCreator")
  testAssignments       TestAssignment[]
  nocLettersReviewed    NOCLetter[]      @relation("NOCReviewer")
  creator               User?            @relation("UserCreator", fields: [createdBy], references: [id])
  created               User[]           @relation("UserCreator")
  role                  Role             @relation(fields: [roleId], references: [id])

  @@map("users")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([otp])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("otp_verifications")
}

model Student {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique @db.VarChar(255)
  fullName             String               @map("full_name") @db.VarChar(255)
  phone                String?              @db.VarChar(20)
  domainId             Int?                 @map("domain_id")
  statusId             Int                  @default(1) @map("status_id")
  registrationDate     DateTime             @default(now()) @map("registration_date")
  formLinkToken        String?              @unique @map("form_link_token") @db.VarChar(100)
  imageUrl             String?              @map("image_url")
  instituteName        String?              @map("institute_name") @db.VarChar(255)
  courseTaken          String?              @map("course_taken") @db.VarChar(255)
  areaOfInterests      String?              @map("area_of_interests") @db.Text
  internshipStartDate  DateTime?            @map("internship_start_date")
  internshipEndDate    DateTime?            @map("internship_end_date")
  internshipDuration   String?              @map("internship_duration") @db.VarChar(50)
  referenceInformation String?              @map("reference_information") @db.Text
  internalFacultyName  String?              @map("internal_faculty_name") @db.VarChar(255)
  facultyContact       String?              @map("faculty_contact") @db.VarChar(20)
  facultyEmail         String?              @map("faculty_email") @db.VarChar(255)
  isActive             Boolean              @default(true) @map("is_active")
  isSelected           Boolean              @default(false) @map("is_selected")
  canRetest            Boolean              @default(false) @map("can_retest")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  createdBy            Int?                 @map("created_by")
  creator              User?                @relation("StudentCreator", fields: [createdBy], references: [id])
  domain               Domain?              @relation(fields: [domainId], references: [id])
  status               InternStatus         @relation(fields: [statusId], references: [id])
  testAssignments      TestAssignment[]
  testAttempts         TestAttempt[]
  studentActivityLogs  StudentActivityLog[] @relation("StudentActivityLogs")
  nocLetters           NOCLetter[]          @relation("NOCLetters")
  videoProgresses      VideoProgress[]
  playlistAccesses     PlaylistAccess[]

  @@index([email])
  @@index([domainId])
  @@index([statusId])
  @@index([formLinkToken])
  @@index([isActive])
  @@index([domainId, statusId, isActive])
  @@map("students")
}

model QuestionPaper {
  id              Int                   @id @default(autoincrement())
  paperName       String                @map("paper_name") @db.VarChar(255)
  description     String?
  subject         String?               @db.VarChar(100)
  year            String?               @db.VarChar(10)
  semester        String?               @db.VarChar(50)
  totalQuestions  Int                   @default(0) @map("total_questions")
  totalWeightage  Int                   @default(0) @map("total_weightage")
  durationMinutes Int                   @default(60) @map("duration_minutes")
  status          QuestionPaperStatus   @default(draft)
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  createdBy       Int                   @map("created_by")
  updatedBy       Int?                  @map("updated_by")
  domains         QuestionPaperDomain[]
  creator         User                  @relation("QuestionPaperCreator", fields: [createdBy], references: [id])
  updater         User?                 @relation("QuestionPaperUpdater", fields: [updatedBy], references: [id])
  questions       Question[]
  testAssignments TestAssignment[]
  testAttempts    TestAttempt[]

  @@index([isActive])
  @@index([status])
  @@index([subject])
  @@index([year])
  @@index([createdBy])
  @@map("question_papers")
}

model QuestionPaperDomain {
  id              Int           @id @default(autoincrement())
  questionPaperId Int           @map("question_paper_id")
  domainId        Int           @map("domain_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  domain          Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questionPaper   QuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  @@unique([questionPaperId, domainId])
  @@index([questionPaperId])
  @@index([domainId])
  @@map("question_paper_domains")
}

model TestAssignment {
  id              Int           @id @default(autoincrement())
  questionPaperId Int           @map("question_paper_id")
  studentId       Int           @map("student_id")
  assignedBy      Int           @map("assigned_by")
  assignedAt      DateTime      @default(now()) @map("assigned_at")
  isActive        Boolean       @default(true) @map("is_active")
  assigner        User          @relation(fields: [assignedBy], references: [id])
  questionPaper   QuestionPaper @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questionPaperId, studentId])
  @@index([questionPaperId])
  @@index([studentId])
  @@index([isActive])
  @@map("test_assignments")
}

model Question {
  id              Int              @id @default(autoincrement())
  questionPaperId Int              @map("question_paper_id")
  questionText    String           @map("question_text")
  questionType    QuestionType     @default(MCQ) @map("question_type")
  weightage       Int              @default(1)
  correctAnswer   String?          @map("correct_answer")
  displayOrder    Int              @default(0) @map("display_order")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       Int              @map("created_by")
  updatedBy       Int?             @map("updated_by")
  section         String?          @db.VarChar(100)
  options         QuestionOption[]
  creator         User             @relation("QuestionCreator", fields: [createdBy], references: [id])
  questionPaper   QuestionPaper    @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  updater         User?            @relation("QuestionUpdater", fields: [updatedBy], references: [id])
  studentAnswers  StudentAnswer[]

  @@index([questionPaperId])
  @@index([questionType])
  @@index([displayOrder])
  @@index([isActive])
  @@index([questionPaperId, isActive, displayOrder])
  @@map("questions")
}

model QuestionOption {
  id             Int             @id @default(autoincrement())
  questionId     Int             @map("question_id")
  optionText     String          @map("option_text")
  optionLabel    String          @map("option_label") @db.VarChar(10)
  isCorrect      Boolean         @default(false) @map("is_correct")
  displayOrder   Int             @default(0) @map("display_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[] @relation("SelectedOption")

  @@index([questionId])
  @@index([isCorrect])
  @@index([displayOrder])
  @@map("question_options")
}

model TestAttempt {
  id                 Int               @id @default(autoincrement())
  studentId          Int               @map("student_id")
  questionPaperId    Int               @map("question_paper_id")
  startedAt          DateTime          @default(now()) @map("started_at")
  submittedAt        DateTime?         @map("submitted_at")
  autoSubmitted      Boolean           @default(false) @map("auto_submitted")
  timeTakenSeconds   Int?              @map("time_taken_seconds")
  totalQuestions     Int               @default(0) @map("total_questions")
  questionsAttempted Int               @default(0) @map("questions_attempted")
  totalScore         Decimal           @default(0) @map("total_score") @db.Decimal(10, 2)
  maxPossibleScore   Decimal           @default(0) @map("max_possible_score") @db.Decimal(10, 2)
  percentageScore    Decimal           @default(0) @map("percentage_score") @db.Decimal(5, 2)
  status             TestAttemptStatus @default(IN_PROGRESS)
  ipAddress          String?           @map("ip_address") @db.VarChar(45)
  userAgent          String?           @map("user_agent")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  questionPool       Json?             @map("question_pool")
  studentAnswers     StudentAnswer[]
  questionPaper      QuestionPaper     @relation(fields: [questionPaperId], references: [id])
  student            Student           @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([questionPaperId])
  @@index([status])
  @@index([submittedAt])
  @@index([studentId, status])
  @@map("test_attempts")
}

model StudentAnswer {
  id                Int             @id @default(autoincrement())
  testAttemptId     Int             @map("test_attempt_id")
  questionId        Int             @map("question_id")
  selectedOptionId  Int?            @map("selected_option_id")
  selectedOptionIds String?         @map("selected_option_ids")
  answerText        String?         @map("answer_text")
  isCorrect         Boolean         @default(false) @map("is_correct")
  scoreObtained     Decimal         @default(0) @map("score_obtained") @db.Decimal(10, 2)
  answeredAt        DateTime        @default(now()) @map("answered_at")
  question          Question        @relation(fields: [questionId], references: [id])
  selectedOption    QuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  testAttempt       TestAttempt     @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, questionId])
  @@index([testAttemptId])
  @@index([questionId])
  @@index([isCorrect])
  @@index([testAttemptId, questionId])
  @@map("student_answers")
}

model ActivityLog {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  userType       UserType @map("user_type")
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       Int?     @map("entity_id")
  description    String?
  requestMethod  String?  @map("request_method") @db.VarChar(10)
  requestPath    String?  @map("request_path") @db.VarChar(255)
  requestBody    Json?    @map("request_body")
  responseStatus Int?     @map("response_status")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([userType])
  @@index([createdAt(sort: Desc)], map: "idx_created_at_desc_logs")
  @@map("activity_logs")
}

model FileUpload {
  id               Int          @id @default(autoincrement())
  fileName         String       @map("file_name") @db.VarChar(255)
  fileType         String       @map("file_type") @db.VarChar(50)
  fileSize         BigInt?      @map("file_size")
  uploadType       UploadType   @map("upload_type")
  status           UploadStatus @default(PENDING)
  recordsProcessed Int          @default(0) @map("records_processed")
  recordsFailed    Int          @default(0) @map("records_failed")
  errorMessage     String?      @map("error_message")
  uploadedBy       Int          @map("uploaded_by")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  uploader         User         @relation(fields: [uploadedBy], references: [id])

  @@index([uploadType])
  @@index([status])
  @@index([uploadedBy])
  @@map("file_uploads")
}

model Playlist {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?
  domainId    Int      @map("domain_id")
  createdAt   DateTime @default(now()) @map("created_at")
  domain      Domain   @relation(fields: [domainId], references: [id])
  videos      Video[]

  @@index([domainId])
  @@map("playlists")
}

model Video {
  id              Int             @id @default(autoincrement())
  playlistId      Int             @map("playlist_id")
  title           String          @db.VarChar(255)
  youtubeUrl      String          @map("youtube_url") @db.VarChar(500)
  orderIndex      Int             @default(0) @map("order_index")
  createdAt       DateTime        @default(now()) @map("created_at")
  playlist        Playlist        @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoProgresses VideoProgress[]

  @@index([playlistId])
  @@index([orderIndex])
  @@index([playlistId, orderIndex])
  @@map("videos")
}

model StudentActivityLog {
  id           Int      @id @default(autoincrement())
  studentId    Int      @map("student_id")
  activityType String   @map("activity_type") @db.VarChar(100)
  metadata     Json?
  timestamp    DateTime @default(now())
  student      Student  @relation("StudentActivityLogs", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([activityType])
  @@index([timestamp])
  @@index([studentId, timestamp])
  @@map("student_activity_logs")
}

model NOCLetter {
  id         Int       @id @default(autoincrement())
  studentId  Int       @map("student_id")
  fileName   String    @map("file_name") @db.VarChar(255)
  filePath   String    @map("file_path") @db.VarChar(500)
  fileSize   BigInt    @map("file_size")
  status     NOCStatus @default(PENDING)
  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy Int?      @map("reviewed_by")
  reviewer   User?     @relation("NOCReviewer", fields: [reviewedBy], references: [id])
  student    Student   @relation("NOCLetters", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([uploadedAt])
  @@map("noc_letters")
}

model VideoProgress {
  id               Int            @id @default(autoincrement())
  studentId        Int            @map("student_id")
  videoId          Int            @map("video_id")
  playlistId       Int            @map("playlist_id")
  openedAt         DateTime?      @map("opened_at")
  startedWatching  DateTime?      @map("started_watching")
  completedAt      DateTime?      @map("completed_at")
  watchTimeSeconds Int            @default(0) @map("watch_time_seconds")
  progressPercent  Decimal        @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastPosition     Decimal        @default(0) @map("last_position") @db.Decimal(10, 2)
  isCompleted      Boolean        @default(false) @map("is_completed")
  replayCount      Int            @default(0) @map("replay_count")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video            Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sessions         VideoSession[]

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
  @@index([playlistId])
  @@index([isCompleted])
  @@index([studentId, isCompleted])
  @@index([studentId, videoId])
  @@map("video_progress")
}

model VideoSession {
  id               Int           @id @default(autoincrement())
  videoProgressId  Int           @map("video_progress_id")
  sessionId        String        @unique @map("session_id") @db.VarChar(100)
  startedAt        DateTime      @map("started_at")
  endedAt          DateTime?     @map("ended_at")
  watchTimeSeconds Int           @default(0) @map("watch_time_seconds")
  maxProgress      Decimal       @default(0) @map("max_progress") @db.Decimal(5, 2)
  isCompleted      Boolean       @default(false) @map("is_completed")
  exitReason       String?       @map("exit_reason") @db.VarChar(50)
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  videoProgress    VideoProgress @relation(fields: [videoProgressId], references: [id], onDelete: Cascade)
  events           VideoEvent[]

  @@index([videoProgressId])
  @@index([sessionId])
  @@index([startedAt])
  @@index([videoProgressId, startedAt])
  @@map("video_sessions")
}

model VideoEvent {
  id              Int          @id @default(autoincrement())
  sessionId       Int          @map("session_id")
  eventType       String       @map("event_type") @db.VarChar(50)
  videoPosition   Decimal      @default(0) @map("video_position") @db.Decimal(10, 2)
  videoDuration   Decimal?     @map("video_duration") @db.Decimal(10, 2)
  progressPercent Decimal      @default(0) @map("progress_percent") @db.Decimal(5, 2)
  playbackRate    Decimal      @default(1) @map("playback_rate") @db.Decimal(3, 2)
  timestamp       DateTime     @default(now())
  metadata        Json?
  session         VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@index([sessionId, eventType])
  @@index([sessionId, timestamp])
  @@map("video_events")
}

model PlaylistAccess {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  playlistId Int      @map("playlist_id")
  openedAt   DateTime @default(now()) @map("opened_at")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([playlistId])
  @@index([studentId, playlistId])
  @@index([openedAt])
  @@map("playlist_access")
}

enum QuestionPaperStatus {
  draft
  published
}

enum QuestionType {
  MCQ
  SINGLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
}

enum TestAttemptStatus {
  IN_PROGRESS
  COMPLETED
  AUTO_SUBMITTED
}

enum UserType {
  USER
  STUDENT
}

enum UploadType {
  QUESTION_PAPER
  STUDENTS
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NOCStatus {
  PENDING
  APPROVED
  REJECTED
}
